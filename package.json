{
  "name": "@shade/grep-ui",
  "version": "0.2.1",
  "description": "Grep UI \u2014 the design system for Grep. Tokens, effects and components as plain CSS, compiled from the Figma component set.",
  "license": "UNLICENSED",
  "private": false,
  "style": "grepmd/grep-ui.css",
  "main": "grepmd/grep-ui.css",
  "exports": {
    ".": "./grepmd/grep-ui.css",
    "./grep-ui.css": "./grepmd/grep-ui.css",
    "./tokens.css": "./grepmd/tokens.css",
    "./effects.css": "./grepmd/effects.css",
    "./grepmd/*": "./grepmd/*",
    "./Components/*": "./Components/*",
    "./package.json": "./package.json",
    "./react": "./react/index.ts",
    "./react/*": "./react/*",
    "./react/icons": "./react/icons/index.tsx"
  },
  "files": [
    "grepmd",
    "Components",
    "Grep UI Opacity",
    "Grep UI Primitive Tokens",
    "Grep UI Scale",
    "Grep UI Semantic Tokens",
    "Grep UI Text",
    "Grep UI effects",
    "AGENTS.md",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielseplovich/grep-ui.git"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
